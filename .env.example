# Copy this file to .env.local and fill in real values. See SETUP.md for
# step-by-step instructions on where to get each one (all free to start).

# ── Supabase (database, auth, file storage) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Brevo (transactional email — 300/day free) ──────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Dr Hemangi Clinic
CLINIC_NOTIFY_EMAIL=

# ── Google Calendar / Meet (OAuth, connected from Admin -> Settings) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/auth/google/callback

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOOKUP_TOKEN_SECRET=change-me-to-a-long-random-string
CLINIC_TIMEZONE=Asia/Kolkata
